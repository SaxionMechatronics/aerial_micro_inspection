<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='X500_inspection'>
    <include merge='true'>
      <uri>model://x500</uri>
    </include>

    <include merge='true'>
      <uri>model://gimbal_zoomed</uri>
      <pose>0 0 0.26 0 0 3.14</pose>
    </include>

    <include>
      <uri>model://rgbd_camera</uri>
      <name>inspection_stereo</name>
      <pose>.12 .03 .242 0 0 0</pose>
    </include>

    <joint name="StereoAttachJoint" type="fixed">
      <parent>base_link</parent>
      <child>inspection_stereo::camera_link</child>
    </joint>

    <joint name="GimbalAttachJoint" type="fixed">
      <parent>base_link</parent>
      <child>cgo3_mount_link</child>
    </joint>
  </model>
</sdf>